    {
      "parameters": {
        "jsCode": "const data = $input.first().json;\n\nconst prompt = `CAHIER DES CHARGES - CREATION SITE WEB\n\n1. INFORMATIONS CLIENT\nType: ${data['Type organisation']}\nNom: ${data['Nom entreprise']}\nSecteur: ${data['Secteur activite']}\nContact: ${data['Email']}\n\n2. PROJET\nType site: ${data['Type site web']}\nObjectif: ${data['Objectif principal']}\nPublic: ${data['Public cible']}\n\n3. FONCTIONNALITES\n${data['Fonctionnalites']}\n\n4. DESIGN\nCharte: ${data['Charte graphique']}\nCouleurs: ${data['Couleurs preferees'] || 'Non specifie'}\nStyle: ${data['Style visuel']}\nReferences: ${data['Sites reference'] || 'Aucune'}\n\n5. CONTENU\nDisponibilite: ${data['Contenu disponible']}\nPages: ${data['Nombre pages']}\nLangues: ${data['Langues']}\n\n6. SEO ET INTEGRATIONS\nSEO: ${data['Besoins SEO']}\nIntegrations: ${data['Integrations'] || 'Aucune'}\n\n7. CONTRAINTES\nBudget: ${data['Budget']}\nDelai: ${data['Delai']}\nMaintenance: ${data['Maintenance']}\n\n8. NOTES\n${data['Infos complementaires'] || 'Aucune'}\n\n---\n\nPROMPT DEVELOPPEUR:\n\nCreer un site ${data['Type site web']} pour ${data['Nom entreprise']} (${data['Type organisation']}) dans le secteur ${data['Secteur activite']}.\n\nObjectif: ${data['Objectif principal']}\nPublic: ${data['Public cible']}\nStyle: ${data['Style visuel']} - ${data['Couleurs preferees'] || 'couleurs a definir'}\n\nFonctionnalites:\n${data['Fonctionnalites']}\n\nStructure: ${data['Nombre pages']} en ${data['Langues']}\nSEO: ${data['Besoins SEO']}\n\nContraintes:\n- Budget: ${data['Budget']}\n- Delai: ${data['Delai']}\n- Charte: ${data['Charte graphique']}\n- Contenu: ${data['Contenu disponible']}\n`;\n\nreturn {\n  json: {\n    prompt: prompt,\n    clientName: data['Nom entreprise'],\n    clientEmail: data['Email'],\n    projectType: data['Type site web'],\n    budget: data['Budget'],\n    deadline: data['Delai'],\n    generatedAt: new Date().toISOString()\n  }\n};"
      },
