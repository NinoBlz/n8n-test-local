    {
      "parameters": {
        "fromEmail": "votre-email@domaine.com",
        "toEmail": "equipe@votre-domaine.com",
        "subject": "=Nouvelle demande de site web - {{ $json.clientName }}",
        "emailType": "html",
        "message": "=<h2>Nouvelle Demande de Création de Site Web</h2>\n\n<p><strong>Client :</strong> {{ $json.clientName }}</p>\n<p><strong>Email :</strong> {{ $json.clientEmail }}</p>\n<p><strong>Type de projet :</strong> {{ $json.projectType }}</p>\n<p><strong>Budget :</strong> {{ $json.budget }}</p>\n<p><strong>Délai :</strong> {{ $json.deadline }}</p>\n\n<hr>\n\n<h3>Prompt Complet :</h3>\n<pre style=\"background: #f4f4f4; padding: 15px; border-radius: 5px; white-space: pre-wrap;\">{{ $json.prompt }}</pre>",
        "options": {}
      },
